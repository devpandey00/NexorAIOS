# Core
DATABASE_URL=
OUTREACH_API_SECRET=

# OpenChatCut video agent
OPENCHATCUT_MCP_URL=http://127.0.0.1:5199/api/external-mcp/mcp
OPENCHATCUT_MCP_TOKEN=
OPENCHATCUT_EDITOR_URL=http://127.0.0.1:5199

# WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Email
RESEND_API_KEY=
OUTREACH_FROM_EMAIL=

# Daily automated business summary email
REPORT_FROM_EMAIL=
REPORT_EMAIL_TO=

# AI
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Search / research
SERPER_API_KEY=

# Meta Marketing / Graph API
META_ACCESS_TOKEN=
META_APP_ID=
META_APP_SECRET=
META_AD_ACCOUNT_ID=
META_BUSINESS_ID=
META_PAGE_ID=
META_INSTAGRAM_ACCOUNT_ID=

# Required separately for social publishing (Facebook/Instagram) — social-publisher.ts
# will not post without these even if the vars above are set.
META_GRAPH_VERSION=v23.0
META_INSTAGRAM_USER_ID=

# LinkedIn publishing (social-publisher.ts) — leave blank to keep LinkedIn unavailable/manual
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=
LINKEDIN_VERSION=202601

# YouTube publishing (social-publisher.ts)
YOUTUBE_ACCESS_TOKEN=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_CATEGORY_ID=22
YOUTUBE_PRIVACY_STATUS=private

# X/Twitter publishing (social-publisher.ts) — leave blank to keep X unavailable/manual
X_ACCESS_TOKEN=

# Google Ads
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Google Analytics / Search Console
# JSON service-account credentials with Analytics/Search Console access, or a temporary OAuth access token.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_ACCESS_TOKEN=
GA4_PROPERTY_ID=
SEARCH_CONSOLE_SITE_URL=

# WordPress / website automation
WORDPRESS_URL=
WORDPRESS_USERNAME=
WORDPRESS_APP_PASSWORD=

# Pinterest (official API v5) — inspiration/research only; never auto-repost.
PINTEREST_ACCESS_TOKEN=
PINTEREST_API_VERSION=v5

# Canva / creative provider
CANVA_ACCESS_TOKEN=

# Outreach queue controls
OUTREACH_MAX_PER_RUN=2
OUTREACH_MAX_PER_RUN_CEILING=100
OUTREACH_MIN_DELAY_MS=2000
SOCIAL_PUBLISH_MAX_PER_RUN=3

# WhatsApp pacing/compliance controls (auto-approve + send-batch routes)
WHATSAPP_DAILY_LIMIT=
WHATSAPP_BATCH_SIZE=10
WHATSAPP_MIN_DELAY_MS=10000

# OpenWA (self-hosted WhatsApp session service) — preferred over Meta Cloud API when fully configured
OPENWA_BASE_URL=
OPENWA_API_KEY=
OPENWA_SESSION_ID=

# Scrapling discovery/enrichment worker (services/scrapling-worker) — must run on a persistent
# host, not Vercel. SCRAPLING_WORKER_API_KEY must also be set on the worker itself, or it refuses
# all requests.
SCRAPLING_WORKER_URL=
SCRAPLING_WORKER_API_KEY=

# Optional webhooks / deployment
NEXT_PUBLIC_APP_URL=
CRON_SECRET=

# Nexor Media brand configuration (optional; existing legacy NEXOR_* vars remain supported)
NEXOR_BRAND_NAME=Nexor Media
NEXOR_BRAND_SHORT_NAME=Nexor
NEXOR_FOUNDER_NAME=Dev Pandey
NEXOR_WEBSITE=
NEXOR_CONTACT_EMAIL=
NEXOR_WHATSAPP=
NEXOR_INSTAGRAM=
NEXOR_LINKEDIN=
NEXOR_PRIMARY_COLOR=#111111
NEXOR_ACCENT_COLOR=#7C3AED
NEXOR_FONT=Inter
NEXOR_TONE=confident, concise, professional, helpful
