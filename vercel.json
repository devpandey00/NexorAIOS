{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "pnpm install --no-frozen-lockfile",
  "buildCommand": "pnpm --filter @nexor/api... build",
  "outputDirectory": "apps/api/.next",
  "crons": [
    { "path": "/api/cron/autopilot", "schedule": "0 */2 * * *" },
    { "path": "/api/automations/run", "schedule": "15 * * * *" },
    { "path": "/api/cron/outreach", "schedule": "30 * * * *" },
    { "path": "/api/cron/followups", "schedule": "45 * * * *" },
    { "path": "/api/cron/social-publish", "schedule": "0 * * * *" },
    { "path": "/api/cron/reports/email", "schedule": "0 13 * * *" }
  ]
}
