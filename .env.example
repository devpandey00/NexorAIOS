# =============================================================================
# NexorAIOS — Environment Configuration
# Copy to .env and adjust values for your local/production environment.
# =============================================================================

NODE_ENV=development
APP_NAME=NexorAIOS
APP_VERSION=0.0.0

# Core production/runtime requirements
DATABASE_URL=postgresql://nexor:nexor_dev_password@localhost:5432/nexoraios?schema=public
DATABASE_READ_URL=postgresql://nexor:nexor_dev_password@localhost:5432/nexoraios?schema=public
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-password-at-least-12-characters

DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
REDIS_URL=redis://localhost:6379
REDIS_TLS=false
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=nexor_minio
S3_SECRET_KEY=minio-local-secret
S3_BUCKET=nexoraios
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
LOG_LEVEL=debug
LOG_FORMAT=pretty
LOG_REDACT_PATHS=password,token,secret,authorization,cookie
OTEL_ENABLED=false
OTEL_SERVICE_NAME=nexoraios
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
JWT_SECRET=change-me-in-production-use-256-bit-secret
CRON_SECRET=
OUTREACH_API_SECRET=

# Zero-cost local AI (default for Social OS)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_MS=60000

# OpenChatCut video agent
OPENCHATCUT_MCP_URL=http://127.0.0.1:5199/api/external-mcp/mcp
OPENCHATCUT_MCP_TOKEN=
OPENCHATCUT_EDITOR_URL=http://127.0.0.1:5199

# WhatsApp Cloud API (fallback/provider)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en_US

# OpenWA self-hosted WhatsApp Web gateway (takes priority when all 3 are set)
# OpenWA is a separate persistent service; do not try to run it inside Vercel.
OPENWA_BASE_URL=
OPENWA_API_KEY=
OPENWA_SESSION_ID=

# Email / Resend
RESEND_API_KEY=
OUTREACH_FROM_EMAIL=
REPORT_FROM_EMAIL=NexorAIOS <reports@example.com>
REPORT_EMAIL_TO=your-email@example.com

# Optional paid/external AI providers. Social OS does not require them.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Search / research
SEARCH_PROVIDER=auto
SEARXNG_URL=
SERPER_API_KEY=
GOOGLE_PLACES_API_KEY=

# Pinterest inspiration/research only. Never use Pinterest content as a repost source.
PINTEREST_ACCESS_TOKEN=
PINTEREST_BOARD_ID=
PINTEREST_API_VERSION=v5

# Canva Connect APIs. Keep credentials server-side; use manual URL fallback when absent.
CANVA_ACCESS_TOKEN=
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
CANVA_REDIRECT_URI=

# Meta Marketing / Graph API
META_ACCESS_TOKEN=
META_APP_ID=
META_APP_SECRET=
META_AD_ACCOUNT_ID=
META_BUSINESS_ID=
META_PAGE_ID=
META_INSTAGRAM_ACCOUNT_ID=
META_GRAPH_VERSION=
META_INSTAGRAM_USER_ID=

# LinkedIn publishing
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=
LINKEDIN_VERSION=202601

# YouTube publishing
YOUTUBE_ACCESS_TOKEN=
YOUTUBE_CATEGORY_ID=22
YOUTUBE_PRIVACY_STATUS=private

# X publishing (official API, OAuth user-context token)
X_ACCESS_TOKEN=

# TikTok Content Posting API (configuration-gated; no fake publish state)
TIKTOK_ACCESS_TOKEN=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Nexor Media brand identity (shared by Sales + Social + Content generators)
NEXOR_BRAND_WEBSITE=
NEXOR_BRAND_CONTACT_EMAIL=
NEXOR_BRAND_CONTACT_PHONE=
NEXOR_BRAND_INSTAGRAM_URL=
NEXOR_BRAND_FACEBOOK_URL=
NEXOR_BRAND_LINKEDIN_URL=
NEXOR_BRAND_YOUTUBE_URL=
NEXOR_BRAND_PINTEREST_URL=
NEXOR_BRAND_X_URL=
NEXOR_BRAND_TIKTOK_URL=
NEXOR_BRAND_COLOR_PRIMARY=
NEXOR_BRAND_COLOR_SECONDARY=
NEXOR_BRAND_FONT_PRIMARY=

# Google Ads
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Google Analytics / Search Console
GOOGLE_SERVICE_ACCOUNT_JSON=
GA4_PROPERTY_ID=
GSC_SITE_URL=

# WordPress / website automation
WORDPRESS_URL=
WORDPRESS_USERNAME=
WORDPRESS_APP_PASSWORD=

# Outreach queue controls
OUTREACH_MAX_PER_RUN=2
OUTREACH_MIN_DELAY_MS=2000

# Job Autopilot
JOB_APPLICANT_NAME=Diwakar Pandey
JOB_APPLICANT_EMAIL=
JOB_APPLICANT_PHONE=
JOB_APPLICANT_LOCATION=India
JOB_PORTFOLIO_URL=
JOB_RESUME_URL=
JOB_TARGET_ROLES=Digital Marketing Specialist,Performance Marketing Specialist,SEO Specialist,Social Media Manager,Growth Marketing Specialist
JOB_TARGET_LOCATIONS=India,Remote,Lucknow
JOB_SKILLS=Google Ads,Meta Ads,SEO,Local SEO,Lead Generation,Social Media Marketing,Website Development,Canva,Google Analytics,Search Console,GTM,AI tools
JOB_FROM_EMAIL=

# Existing autopilot
AUTO_DISCOVERY_BATCH_SIZE=1
AUTOPILOT_SOCIAL_DRAFTS=true
AUTOPILOT_JOB_LOCATION=
AUTOPILOT_COMPANY_LOCATION=
AUTOPILOT_INFLUENCER_LOCATION=

# Optional public app URL
NEXT_PUBLIC_APP_URL=
