# =============================================================================
# NexorAIOS — Environment Configuration
# Copy to .env and adjust values for your environment.
# =============================================================================

# Application
NODE_ENV=development
APP_NAME=NexorAIOS
APP_VERSION=0.0.0

# Database (PostgreSQL)
DATABASE_URL=postgresql://nexor:nexor_dev_password@localhost:5432/nexoraios?schema=public
DATABASE_READ_URL=postgresql://nexor:nexor_dev_password@localhost:5432/nexoraios?schema=public
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Redis
REDIS_URL=redis://localhost:6379
REDIS_TLS=false

# S3-compatible storage (MinIO in development)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=nexor_minio
S3_SECRET_KEY=nexor_minio_secret
S3_BUCKET=nexoraios
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# Logging
LOG_LEVEL=debug
LOG_FORMAT=pretty
LOG_REDACT_PATHS=password,token,secret,authorization,cookie

# Observability (prepared for future integration)
OTEL_ENABLED=false
OTEL_SERVICE_NAME=nexoraios
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Security (used by future auth modules)
JWT_SECRET=change-me-in-production-use-256-bit-secret
