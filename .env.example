# =============================================================================
# NexorAIOS — Environment Configuration
# Copy to .env and adjust values for your local/production environment.
# =============================================================================

NODE_ENV=development
APP_NAME=NexorAIOS
APP_VERSION=0.0.0

# Core production/runtime requirements
DATABASE_URL=postgresql://nexor:nexor_dev_password@localhost:5432/nexoraios?schema=public
DATABASE_READ_URL=postgresql://nexor:nexor_dev_password@localhost:5432/nexoraios?schema=public
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-password-at-least-12-characters

DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
REDIS_URL=redis://localhost:6379
REDIS_TLS=false
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=nexor_minio
S3_SECRET_KEY=nexor_minio_secret
S3_BUCKET=nexoraios
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
LOG_LEVEL=debug
LOG_FORMAT=pretty
LOG_REDACT_PATHS=password,token,secret,authorization,cookie
OTEL_ENABLED=false
OTEL_SERVICE_NAME=nexoraios
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
JWT_SECRET=change-me-in-production-use-256-bit-secret
CRON_SECRET=
OUTREACH_API_SECRET=

# OpenChatCut video agent
OPENCHATCUT_MCP_URL=http://127.0.0.1:5199/api/external-mcp/mcp
OPENCHATCUT_MCP_TOKEN=
OPENCHATCUT_EDITOR_URL=http://127.0.0.1:5199

# WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Email / Resend
RESEND_API_KEY=
OUTREACH_FROM_EMAIL=
REPORT_FROM_EMAIL=NexorAIOS <reports@example.com>
REPORT_EMAIL_TO=your-email@example.com

# AI providers (configure at least one supported provider)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Search / research
SERPER_API_KEY=

# Meta Marketing / Graph API
META_ACCESS_TOKEN=
META_APP_ID=
META_APP_SECRET=
META_AD_ACCOUNT_ID=
META_BUSINESS_ID=
META_PAGE_ID=
META_INSTAGRAM_ACCOUNT_ID=

# Google Ads
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Google Analytics / Search Console
GOOGLE_SERVICE_ACCOUNT_JSON=
GA4_PROPERTY_ID=
GSC_SITE_URL=

# WordPress / website automation
WORDPRESS_URL=
WORDPRESS_USERNAME=
WORDPRESS_APP_PASSWORD=

# Outreach queue controls
OUTREACH_MAX_PER_RUN=2
OUTREACH_MIN_DELAY_MS=2000

# Job Autopilot
JOB_APPLICANT_NAME=Diwakar Pandey
JOB_APPLICANT_EMAIL=
JOB_APPLICANT_PHONE=
JOB_APPLICANT_LOCATION=India
JOB_PORTFOLIO_URL=
JOB_RESUME_URL=
JOB_TARGET_ROLES=Digital Marketing Specialist,Performance Marketing Specialist,SEO Specialist,Social Media Manager,Growth Marketing Specialist
JOB_TARGET_LOCATIONS=India,Remote,Lucknow
JOB_SKILLS=Google Ads,Meta Ads,SEO,Local SEO,Lead Generation,Social Media Marketing,Website Development,Canva,Google Analytics,Search Console,GTM,AI tools
JOB_FROM_EMAIL=

# Existing autopilot
AUTO_DISCOVERY_BATCH_SIZE=3
AUTOPILOT_SOCIAL_DRAFTS=true
AUTOPILOT_JOB_LOCATION=
AUTOPILOT_COMPANY_LOCATION=
AUTOPILOT_INFLUENCER_LOCATION=

# Optional public app URL
NEXT_PUBLIC_APP_URL=
