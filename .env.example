# =============================================================================
# NexorAIOS — Environment Configuration
# Copy to .env and adjust values for your environment.
# =============================================================================

NODE_ENV=development
APP_NAME=NexorAIOS
APP_VERSION=0.0.0

DATABASE_URL=postgresql://nexor:nexor_dev_password@localhost:5432/nexoraios?schema=public
DATABASE_READ_URL=postgresql://nexor:nexor_dev_password@localhost:5432/nexoraios?schema=public
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

REDIS_URL=redis://localhost:6379
REDIS_TLS=false

S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=nexor_minio
S3_SECRET_KEY=nexor_minio_secret
S3_BUCKET=nexoraios
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

LOG_LEVEL=debug
LOG_FORMAT=pretty
LOG_REDACT_PATHS=password,token,secret,authorization,cookie

OTEL_ENABLED=false
OTEL_SERVICE_NAME=nexoraios
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

JWT_SECRET=change-me-in-production-use-256-bit-secret
CRON_SECRET=

RESEND_API_KEY=
REPORT_FROM_EMAIL=NexorAIOS <reports@example.com>
REPORT_EMAIL_TO=your-email@example.com

# Research + AI
BRAVE_SEARCH_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en_US
OUTREACH_API_SECRET=
# Autopilot only sends after its own WhatsApp verification check succeeds.
AUTOPILOT_AUTO_SEND_WHATSAPP=false
AUTOPILOT_RESEARCH_BATCH_SIZE=5
NEXT_PUBLIC_APP_URL=

# Autopilot
AUTO_DISCOVERY_BATCH_SIZE=3
AUTOPILOT_SOCIAL_DRAFTS=true
AUTOPILOT_JOB_LOCATION=
AUTOPILOT_COMPANY_LOCATION=
AUTOPILOT_INFLUENCER_LOCATION=
