{
  "name": "nexor-ai-os",
  "version": "0.0.1",
  "private": true,
  "description": "NexorAIOS — Enterprise AI Operating System for Businesses",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": "22.x",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --parallel --filter './apps/*' dev",
    "setup": "node scripts/nexor-setup.mjs",
    "start:local": "node scripts/nexor-setup.mjs && pnpm dev",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:packages": "pnpm --filter './packages/*' build",
    "typecheck": "pnpm build:packages && pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:ci": "pnpm -r test:ci",
    "clean": "pnpm -r clean && rm -rf node_modules",
    "db:generate": "pnpm --filter @nexor/database db:generate",
    "db:migrate": "pnpm --filter @nexor/database db:migrate",
    "db:migrate:deploy": "pnpm --filter @nexor/database db:migrate:deploy",
    "db:seed": "pnpm --filter @nexor/database db:seed",
    "db:studio": "pnpm --filter @nexor/database db:studio",
    "docker:up": "docker compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f docker/docker-compose.yml down",
    "docker:logs": "docker compose -f docker/docker-compose.yml logs -f",
    "docker:reset": "docker compose -f docker/docker-compose.yml down -v && docker compose -f docker/docker-compose.yml up -d",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@nexor/config": "workspace:*",
    "eslint": "^9.17.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0",
    "next": "16.2.12",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3"
  }
}
