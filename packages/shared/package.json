{
  "name": "@nexor/shared",
  "version": "0.0.0",
  "private": true,
  "description": "Shared types, errors, events, and constants for NexorAIOS",
  "type": "module",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./errors": { "types": "./dist/errors/index.d.ts", "import": "./dist/errors/index.js" },
    "./events": { "types": "./dist/events/index.d.ts", "import": "./dist/events/index.js" },
    "./constants": { "types": "./dist/constants/index.d.ts", "import": "./dist/constants/index.js" },
    "./brand": { "types": "./dist/brand/index.d.ts", "import": "./dist/brand/index.js" }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings 0",
    "lint:fix": "eslint src --fix",
    "test": "vitest run",
    "test:ci": "vitest run --coverage",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@nexor/config": "workspace:*",
    "@types/node": "^22.10.5",
    "eslint": "^9.17.0",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8",
    "@vitest/coverage-v8": "^2.1.8"
  }
}
