{
  "name": "@nexor/logger",
  "version": "0.0.0",
  "private": true,
  "description": "Structured logging infrastructure for NexorAIOS with correlation IDs and observability preparation",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings 0",
    "lint:fix": "eslint src --fix",
    "test": "vitest run",
    "test:ci": "vitest run --coverage",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@nexor/shared": "workspace:*",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0"
  },
  "devDependencies": {
    "@nexor/config": "workspace:*",
    "@types/node": "^22.10.5",
    "eslint": "^9.17.0",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
