{
  "name": "@nexor/database",
  "version": "0.0.0",
  "private": true,
  "description": "Enterprise database layer for NexorAIOS — Prisma, repositories, transactions, and seeds",
  "type": "module",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./client": { "types": "./dist/client/index.d.ts", "import": "./dist/client/index.js" },
    "./repository": { "types": "./dist/repository/index.d.ts", "import": "./dist/repository/index.js" },
    "./transaction": { "types": "./dist/transaction/index.d.ts", "import": "./dist/transaction/index.js" }
  },
  "files": ["dist", "prisma"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --ignore-pattern '**/*.test.ts' --max-warnings 0",
    "lint:fix": "eslint src --ignore-pattern '**/*.test.ts' --fix",
    "test": "vitest run",
    "test:ci": "vitest run --coverage",
    "clean": "rm -rf dist",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:reset": "prisma migrate reset --force",
    "db:seed": "tsx src/seed/index.ts",
    "db:studio": "prisma studio",
    "db:push": "prisma db push",
    "postinstall": "prisma generate"
  },
  "dependencies": { "@nexor/logger": "workspace:*", "@nexor/shared": "workspace:*", "@prisma/client": "^6.2.1" },
  "devDependencies": {
    "@nexor/config": "workspace:*",
    "@types/node": "^22.10.5",
    "eslint": "^9.17.0",
    "prisma": "^6.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8",
    "@vitest/coverage-v8": "^2.1.8"
  }
}
