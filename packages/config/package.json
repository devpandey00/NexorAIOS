{
  "name": "@nexor/config",
  "version": "0.0.0",
  "private": true,
  "description": "Shared configuration for NexorAIOS — ESLint, Prettier, TypeScript, and environment validation",
  "type": "module",
  "exports": {
    "./eslint/base": "./eslint/base.js",
    "./eslint/node": "./eslint/node.js",
    "./prettier": "../../prettier.config.cjs",
    "./typescript/base": "./typescript/base.json",
    "./typescript/node": "./typescript/node.json",
    "./typescript/library": "./typescript/library.json",
    "./env": {
      "types": "./dist/env/index.d.ts",
      "import": "./dist/env/index.js"
    }
  },
  "files": [
    "eslint",
    "typescript",
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings 0",
    "lint:fix": "eslint src --fix",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.5",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.1"
  }
}
